    "        elif menu_input == \"5\":\n",
    "            print(\"Exiting the Weather Dashboard.\")\n",
    "            break\n",
    "        else:\n",
    "            print(\"Invalid choice. Please try again.\")\n",
    "\n",
    "# Run the main menu\n",
